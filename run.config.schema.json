{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "number", "const": 1},
    "directory": {"type": "string", "minLength": 1},
    "envFile": {"type": "string", "minLength": 1},
    "providers": {"type": "string", "minLength": 1},
    "authentication": {
      "type": "object",
      "properties": {
        "module": {"type": "string", "minLength": 1},
        "options": {
          "type": "object",
          "propertyNames": {"type": "string"},
          "additionalProperties": {}
        }
      },
      "required": ["module", "options"],
      "additionalProperties": false
    },
    "tts": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "provider": {"type": "string", "const": "speechkit"},
            "options": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "voice": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
                    "speed": {"type": "number", "minimum": 0.1, "maximum": 3},
                    "apiKey": {
                      "anyOf": [
                        {"type": "string", "minLength": 1},
                        {
                          "type": "object",
                          "properties": {"env": {"type": "string", "pattern": "^[A-Za-z_]\\w*$"}},
                          "required": ["env"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {"file": {"type": "string", "minLength": 1}},
                          "required": ["file"],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": ["apiKey"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "voice": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
                    "speed": {"type": "number", "minimum": 0.1, "maximum": 3},
                    "iamToken": {
                      "anyOf": [
                        {"type": "string", "minLength": 1},
                        {
                          "type": "object",
                          "properties": {"env": {"type": "string", "pattern": "^[A-Za-z_]\\w*$"}},
                          "required": ["env"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {"file": {"type": "string", "minLength": 1}},
                          "required": ["file"],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "folderId": {"type": "string", "minLength": 1}
                  },
                  "required": ["iamToken"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "voice": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
                    "speed": {"type": "number", "minimum": 0.1, "maximum": 3},
                    "serviceAccountKey": {
                      "anyOf": [
                        {"type": "string", "minLength": 1},
                        {
                          "type": "object",
                          "properties": {"env": {"type": "string", "pattern": "^[A-Za-z_]\\w*$"}},
                          "required": ["env"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {"file": {"type": "string", "minLength": 1}},
                          "required": ["file"],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": ["serviceAccountKey"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "voice": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
                    "speed": {"type": "number", "minimum": 0.1, "maximum": 3},
                    "serviceAccount": {
                      "type": "object",
                      "properties": {
                        "keyId": {
                          "anyOf": [
                            {"type": "string", "minLength": 1},
                            {
                              "type": "object",
                              "properties": {
                                "env": {"type": "string", "pattern": "^[A-Za-z_]\\w*$"}
                              },
                              "required": ["env"],
                              "additionalProperties": false
                            }
                          ]
                        },
                        "serviceAccountId": {
                          "anyOf": [
                            {"type": "string", "minLength": 1},
                            {
                              "type": "object",
                              "properties": {
                                "env": {"type": "string", "pattern": "^[A-Za-z_]\\w*$"}
                              },
                              "required": ["env"],
                              "additionalProperties": false
                            }
                          ]
                        },
                        "privateKey": {
                          "anyOf": [
                            {"type": "string", "minLength": 1},
                            {
                              "type": "object",
                              "properties": {
                                "env": {"type": "string", "pattern": "^[A-Za-z_]\\w*$"}
                              },
                              "required": ["env"],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {"file": {"type": "string", "minLength": 1}},
                              "required": ["file"],
                              "additionalProperties": false
                            }
                          ]
                        }
                      },
                      "required": ["keyId", "serviceAccountId", "privateKey"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["serviceAccount"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": ["provider", "options"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "module": {"type": "string", "minLength": 1},
            "options": {
              "type": "object",
              "propertyNames": {"type": "string"},
              "additionalProperties": {}
            }
          },
          "required": ["module", "options"],
          "additionalProperties": false
        }
      ]
    },
    "storageState": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "properties": {"env": {"type": "string", "pattern": "^[A-Za-z_]\\w*$"}},
          "required": ["env"],
          "additionalProperties": false
        }
      ]
    },
    "policy": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "properties": {
            "rules": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "origin": {"type": "string"},
                  "pathPrefix": {"type": "string"},
                  "path": {"type": "string"},
                  "actions": {
                    "minItems": 1,
                    "type": "array",
                    "items": {"type": "string", "enum": ["read", "act", "evaluate"]}
                  }
                },
                "required": ["origin", "actions"],
                "additionalProperties": false
              }
            },
            "networkAllowedOrigins": {"minItems": 1, "type": "array", "items": {"type": "string"}},
            "capture": {
              "type": "object",
              "properties": {
                "postReads": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "origin": {"type": "string"},
                      "path": {"type": "string", "format": "starts_with", "pattern": "^\\/.*"}
                    },
                    "required": ["origin", "path"],
                    "additionalProperties": false
                  }
                },
                "deniedHosts": {"maxItems": 100, "type": "array", "items": {"type": "string"}},
                "navigationUrls": {
                  "minItems": 1,
                  "maxItems": 100,
                  "type": "array",
                  "items": {"type": "string", "maxLength": 8192}
                },
                "networkAllowedOrigins": {
                  "minItems": 1,
                  "maxItems": 100,
                  "type": "array",
                  "items": {"type": "string"}
                },
                "readOnlyActions": {
                  "maxItems": 1000,
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "origin": {"type": "string", "maxLength": 8192},
                          "path": {
                            "type": "string",
                            "maxLength": 4096,
                            "format": "starts_with",
                            "pattern": "^\\/.*"
                          },
                          "tool": {
                            "type": "string",
                            "enum": ["browser_click", "browser_hover", "browser_scroll_to"]
                          },
                          "ref": {"type": "string", "maxLength": 256, "pattern": "^[a-zA-Z0-9_-]+$"}
                        },
                        "required": ["origin", "path", "tool", "ref"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "origin": {"type": "string", "maxLength": 8192},
                          "path": {
                            "type": "string",
                            "maxLength": 4096,
                            "format": "starts_with",
                            "pattern": "^\\/.*"
                          },
                          "tool": {"type": "string", "const": "browser_press_key"},
                          "key": {"type": "string", "const": "Escape"}
                        },
                        "required": ["origin", "path", "tool", "key"],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "additionalProperties": false
            },
            "readOnlyNetwork": {
              "type": "object",
              "properties": {
                "postReads": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "origin": {"type": "string"},
                      "path": {"type": "string", "format": "starts_with", "pattern": "^\\/.*"}
                    },
                    "required": ["origin", "path"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["postReads"],
              "additionalProperties": false
            }
          },
          "required": ["rules"],
          "additionalProperties": false
        }
      ]
    },
    "screenshotPolicy": {
      "type": "object",
      "properties": {
        "redaction": {
          "type": "object",
          "properties": {
            "replacements": {
              "default": [],
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from": {"type": "string", "minLength": 3, "maxLength": 2048},
                  "to": {"type": "string", "maxLength": 2048}
                },
                "required": ["from", "to"],
                "additionalProperties": false
              }
            },
            "hide": {
              "default": [],
              "maxItems": 32,
              "type": "array",
              "items": {"type": "string", "minLength": 1, "maxLength": 512}
            }
          },
          "additionalProperties": false
        },
        "requireRedaction": {"default": false, "type": "boolean"}
      },
      "additionalProperties": false
    },
    "browser": {
      "type": "object",
      "properties": {
        "locale": {"type": "string", "minLength": 1},
        "colorScheme": {"type": "string", "enum": ["light", "dark", "no-preference"]},
        "url": {"type": "string", "format": "uri"},
        "video": {"type": "boolean"},
        "headless": {"type": "boolean"},
        "viewport": {
          "type": "object",
          "properties": {
            "width": {"type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991},
            "height": {"type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991}
          },
          "required": ["width", "height"],
          "additionalProperties": false
        },
        "deviceScaleFactor": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "properties": {
        "video": {
          "type": "object",
          "properties": {
            "name": {
              "default": "walkthrough",
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
            },
            "highlights": {"default": false, "type": "boolean"},
            "outline": {
              "type": "object",
              "properties": {
                "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
                "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 256},
                "padding": {"type": "number", "minimum": 0, "maximum": 256},
                "radius": {"type": "number", "minimum": 0, "maximum": 256},
                "opacity": {"type": "number", "minimum": 0, "maximum": 1}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "screenshots": {
          "type": "object",
          "properties": {
            "highlight": {"type": "boolean"},
            "outline": {
              "type": "object",
              "properties": {
                "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
                "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 256},
                "padding": {"type": "number", "minimum": 0, "maximum": 256},
                "radius": {"type": "number", "minimum": 0, "maximum": 256},
                "opacity": {"type": "number", "minimum": 0, "maximum": 1}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "narration": {
          "type": "object",
          "properties": {
            "name": {
              "default": "narrated",
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
            },
            "captions": {"default": false, "type": "boolean"},
            "maxHoldSeconds": {"default": 5, "type": "number", "minimum": 0, "maximum": 5}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["version"],
  "additionalProperties": false
}
