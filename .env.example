# Copy to .env, keep mode 0600 and fill values locally. Never commit .env.
# Existing process environment values take precedence, including empty values.
# Main launch sample: the host authentication module consumes these fields.
SCREENCASTER_LOGIN=
SCREENCASTER_PASSWORD=
SPEECHKIT_API_KEY=

# For a prepared session, replace authentication with storageState in the config.
# SCREENCASTER_STORAGE_STATE=/absolute/path/to/browser-state.json

# Alternatives: select the matching tts.options mode in run.config.json.
# SPEECHKIT_IAM_TOKEN=
# For serviceAccount mode, uncomment and fill all three fields below.
# SPEECHKIT_SERVICE_ACCOUNT_ID=
# SPEECHKIT_SERVICE_ACCOUNT_KEY_ID=
# SPEECHKIT_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----
# REPLACE_PEM_BODY
# -----END PRIVATE KEY-----'
