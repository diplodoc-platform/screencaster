{
  "name": "@diplodoc/screencaster",
  "version": "0.0.1",
  "description": "Browser guide media generation for documentation",
  "license": "MIT",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "bin": {
    "screencaster": "build/cli.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "start": "node build/cli.js",
    "lint": "lint",
    "lint:fix": "lint fix",
    "prepack": "npm run build",
    "lock": "npm install --no-workspaces --package-lock-only --ignore-scripts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "pre-commit": "lint-staged",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@diplodoc/infra": "2.3.0",
    "@types/node": "^24.13.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.5.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diplodoc-platform/screencaster.git"
  },
  "homepage": "https://github.com/diplodoc-platform/screencaster#readme",
  "bugs": {
    "url": "https://github.com/diplodoc-platform/screencaster/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
