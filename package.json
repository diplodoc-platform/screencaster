  "bin": {
    "screencaster": "build/cli.js"
  },
  "files": [
    "build",
    "!build/browser/scripts/driver/*.js",
    "!build/browser/scripts/dom/*.js",
    ".agents/skills/screencaster",
    "examples/host-adapters",
    "docs/host-adapters.md",
    "docs/illustrations.md",
    "run.config.example.json",
    "!examples/private-adapters",
    "!build/examples/private-adapters",
    "run.config.schema.json",
    ".env.example",
    "!.env"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('build', {recursive: true, force: true})\" && tsc -p tsconfig.json && npm run build:scripts && npm run build:examples",
    "watch": "npm run build && node scripts/watch.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node build/cli.js",
    "lint": "lint && npm run format:check",
    "lint:fix": "lint fix && npm run format",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build && node scripts/generate-configuration.mjs --check",
    "lock": "npm install --no-workspaces --package-lock-only --ignore-scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "npm run build:scripts",
    "test:coverage": "vitest run --coverage",
    "pre-commit": "lint-staged",
    "prepare": "husky || true",
    "test:browser": "vitest run --config vitest.browser.config.mjs",
    "build:scripts": "node scripts/build-browser-scripts.mjs",
    "pretest": "npm run build:scripts",
    "pretest:browser": "npm run build:scripts",
    "test:architecture": "vitest run test/architecture",
    "test:package": "npm run build && node scripts/generate-configuration.mjs --check && node scripts/test-package.mjs",
    "benchmark": "npm run build && tsc -p scripts/tsconfig.json && node --expose-gc scripts/benchmark.ts",
    "test:examples": "npm run build && node build/examples/host-adapters/synthetic.js",
    "build:examples": "tsc -p examples/tsconfig.build.json",
    "docs:generate": "npm run build && node scripts/generate-configuration.mjs",
    "docs:check": "npm run build && node scripts/generate-configuration.mjs --check"
  },
  "devDependencies": {
    "@diplodoc/infra": "2.3.0",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.27.7",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.5.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diplodoc-platform/screencaster.git"
  },
  "homepage": "https://github.com/diplodoc-platform/screencaster#readme",
  "bugs": {
    "url": "https://github.com/diplodoc-platform/screencaster/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@napi-rs/canvas": "^1.1.1",
    "@playwright/mcp": "^0.0.86",
    "ajv": "^8.20.0",
    "image-size": "^2.1.0",
    "jpeg-js": "^0.4.4",
    "playwright": "^1.58.1",
    "pngjs": "^7.0.0",
    "zod": "^4.6.7"
  }
}
