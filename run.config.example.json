{
  "$schema": "./run.config.schema.json",
  "version": 1,
  "envFile": ".env",
  "directory": "./runs",
  "authentication": {
    "module": "./host/authentication.js",
    "options": {
      "allowedOrigins": ["https://app.example.com"],
      "login": {
        "env": "SCREENCASTER_LOGIN"
      },
      "password": {
        "env": "SCREENCASTER_PASSWORD"
      }
    }
  },
  "tts": {
    "provider": "speechkit",
    "options": {
      "apiKey": {
        "env": "SPEECHKIT_API_KEY"
      },
      "voice": "jane",
      "speed": 1
    }
  },
  "browser": {
    "url": "https://app.example.com",
    "headless": true,
    "video": true,
    "locale": "en-US",
    "viewport": {
      "width": 1440,
      "height": 1000
    },
    "deviceScaleFactor": 1
  },
  "policy": {
    "rules": [
      {
        "origin": "https://app.example.com",
        "pathPrefix": "/",
        "actions": ["read", "act"]
      }
    ]
  },
  "screenshotPolicy": {
    "requireRedaction": false
  },
  "outputs": {
    "video": {
      "name": "walkthrough",
      "highlights": true,
      "outline": {
        "color": "#5282FF",
        "width": 5,
        "padding": 15.5,
        "radius": 18,
        "opacity": 1
      }
    },
    "screenshots": {
      "highlight": true,
      "outline": {
        "color": "#ff4f4f",
        "width": 3,
        "padding": 0,
        "radius": 4,
        "opacity": 1
      }
    },
    "narration": {
      "name": "narrated",
      "captions": true,
      "maxHoldSeconds": 5
    }
  }
}
